{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Public assignment progress snapshot",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "snapshot_utc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "projected_utc": {
      "type": "string",
      "format": "date-time"
    },
    "connected": {
      "type": "boolean"
    },
    "stale": {
      "type": "boolean"
    },
    "failure": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "enum": [
          "SNAPSHOT_UNAVAILABLE",
          "SNAPSHOT_MALFORMED",
          "SNAPSHOT_TIME_INVALID",
          "SNAPSHOT_IN_FUTURE",
          "MONITOR_DISCONNECTED",
          "MONITOR_STATUS_UNKNOWN",
          "SNAPSHOT_STALE",
          "SCHEDULER_UNAVAILABLE",
          "ACCOUNTING_UNAVAILABLE",
          "MONITOR_WARNING",
          "ACTIVE_JOB_FAILED",
          "RESULT_MALFORMED",
          "INVALID_DATA_DROPPED",
          "EVIDENCE_UNAVAILABLE",
          "UNMAPPED_JOB",
          "PREDICTIONS_NOT_VERIFIED"
        ]
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "age_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000000000
        },
        "stale_after_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3600
        },
        "monitor_checked_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "age_seconds",
        "stale_after_seconds",
        "monitor_checked_utc"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sentiment_completed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "caption_completed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "required": [
        "sentiment_completed",
        "caption_completed"
      ]
    },
    "sentiment_runs": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "rnn_uni",
              "rnn_bi",
              "lstm_uni",
              "lstm_bi",
              "lstm_bi_embedding100"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "state": {
            "enum": [
              "unavailable",
              "unknown",
              "preparing",
              "queued",
              "running",
              "saving",
              "complete",
              "failed"
            ]
          },
          "completed": {
            "type": "boolean"
          },
          "completed_epochs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "total_epochs": {
            "const": 20
          },
          "test_accuracy": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "test_examples": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000000
          },
          "training_loss": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000000
          },
          "updated_at_utc": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "config": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "architecture": {
                "enum": [
                  "RNN",
                  "LSTM"
                ]
              },
              "bidirectional": {
                "type": "boolean"
              },
              "embedding_dim": {
                "enum": [
                  10,
                  100
                ]
              },
              "hidden_dim": {
                "const": 164
              },
              "classes": {
                "const": 2
              }
            },
            "required": [
              "architecture",
              "bidirectional",
              "embedding_dim",
              "hidden_dim",
              "classes"
            ]
          },
          "history": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "epoch": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "loss": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1000000000000
                },
                "accuracy": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "seconds": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1000000000000
                }
              },
              "required": [
                "epoch",
                "loss",
                "accuracy",
                "seconds"
              ]
            }
          }
        },
        "required": [
          "id",
          "label",
          "state",
          "completed",
          "completed_epochs",
          "total_epochs",
          "test_accuracy",
          "test_examples",
          "training_loss",
          "updated_at_utc",
          "config",
          "history"
        ]
      }
    },
    "caption_runs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "baseline",
              "alternate_encoder",
              "simple_rnn"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "state": {
            "enum": [
              "unavailable",
              "unknown",
              "preparing",
              "queued",
              "running",
              "saving",
              "complete",
              "failed"
            ]
          },
          "completed": {
            "type": "boolean"
          },
          "completed_epochs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "updated_at_utc": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "config": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "backbone": {
                "enum": [
                  "resnet50",
                  "googlenet"
                ]
              },
              "cell": {
                "enum": [
                  "rnn",
                  "lstm"
                ]
              },
              "precision": {
                "const": "float32"
              },
              "channels_last": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "backbone",
              "cell",
              "precision",
              "channels_last"
            ]
          },
          "progress": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "epoch": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1000000000000
              },
              "completed_batches": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1000000000000
              },
              "total_batches": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1000000000000
              },
              "seen_captions": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1000000000000
              },
              "total_captions": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1000000000000
              },
              "loss": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1000000000000
              },
              "perplexity": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1000000000000
              },
              "elapsed_seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1000000000000
              }
            },
            "required": [
              "epoch",
              "completed_batches",
              "total_batches",
              "seen_captions",
              "total_captions",
              "loss",
              "perplexity",
              "elapsed_seconds"
            ]
          },
          "history": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "epoch": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "loss": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1000000000000
                },
                "perplexity": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1000000000000
                },
                "captions": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1000000000000
                },
                "batches": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1000000000000
                },
                "tokens": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1000000000000
                },
                "seconds": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1000000000000
                }
              },
              "required": [
                "epoch",
                "loss",
                "perplexity",
                "captions",
                "batches",
                "tokens",
                "seconds"
              ]
            }
          }
        },
        "required": [
          "id",
          "label",
          "state",
          "completed",
          "completed_epochs",
          "updated_at_utc",
          "config",
          "progress",
          "history"
        ]
      }
    },
    "jobs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "enum": [
              "Baseline caption model",
              "GoogLeNet caption model",
              "RNN caption model",
              "Caption comparison",
              "Tracked task"
            ]
          },
          "state": {
            "enum": [
              "unavailable",
              "unknown",
              "preparing",
              "queued",
              "running",
              "saving",
              "complete",
              "failed"
            ]
          },
          "elapsed": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(?:[0-9]{1,5}-)?[0-9]{1,6}:[0-9]{2}(?::[0-9]{2})?$",
            "maxLength": 24
          },
          "exit_code": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{1,4}:[0-9]{1,4}$",
            "maxLength": 9
          },
          "failed": {
            "type": "boolean"
          }
        },
        "required": [
          "label",
          "state",
          "elapsed",
          "exit_code",
          "failed"
        ]
      }
    },
    "batch_events": {
      "type": "array",
      "maxItems": 72,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "enum": [
              "rnn_uni",
              "rnn_bi",
              "lstm_uni",
              "lstm_bi",
              "lstm_bi_embedding100",
              "baseline",
              "alternate_encoder",
              "simple_rnn"
            ]
          },
          "observed_at_utc": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "epoch": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000000
          },
          "batch": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000
          },
          "total_batches": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000
          },
          "loss": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000000
          },
          "accuracy": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "elapsed_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000000
          },
          "batch_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000000
          },
          "kind": {
            "enum": [
              "batch_loss",
              "running_epoch_loss"
            ]
          }
        },
        "required": [
          "run_id",
          "observed_at_utc",
          "epoch",
          "batch",
          "total_batches",
          "loss",
          "accuracy",
          "elapsed_seconds",
          "batch_seconds",
          "kind"
        ]
      }
    },
