                },
                "predictions_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "observations_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "captions": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "baseline": {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 8192
                    },
                    "alternate_encoder": {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 8192
                    },
                    "simple_rnn": {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 8192
                    }
                  },
                  "required": [
                    "baseline",
                    "alternate_encoder",
                    "simple_rnn"
                  ]
                },
                "observation": {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 2000
                }
              },
              "required": [
                "image_id",
                "image_url",
                "image_sha256",
                "predictions_sha256",
                "observations_sha256",
