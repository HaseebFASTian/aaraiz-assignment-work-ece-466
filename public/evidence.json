  "methodological_notes": [
    {
      "id": "course_split",
      "title": "Course split, not the original benchmark split",
      "text": "The five accuracies use the same newly formed 5,000-review held-out set, not the original 25,000-review IMDB test split."
    },
    {
      "id": "single_seed",
      "title": "Matched comparisons",
      "text": "Architecture is compared at fixed direction and direction within each architecture. These are single-seed, fixed-budget results; statistical significance is not established."
    },
    {
      "id": "bonus_accuracy",
      "title": "Bonus improves accuracy, not every metric",
      "text": "Embedding 100 improves BiLSTM accuracy by 4.36 percentage points and 218 reviews. Its test cross-entropy is higher, so no improvement in every metric is claimed."
    },
    {
      "id": "resume",
      "title": "Strict epoch-boundary continuation",
      "text": "The unidirectional RNN continued from completed epoch 10 with model and Adam state restored and batch permutations replayed. No denormal-flush or precision change was made. Timing excludes discarded partial work and downtime."
    },
    {
      "id": "layout",
      "title": "Recorded memory-layout optimization",
      "text": "ResNet50 caption models use channels-last; GoogLeNet uses contiguous layout. Architecture, FP32, optimizer, data and training-mode CNN statistics are unchanged. Checkpoints restore their own format; reduction order may differ."
    },
    {
      "id": "full_pass",
      "title": "Every caption counted once",
      "text": "Equal-length batches are shuffled without replacement. Superseded partial runs are excluded from final comparisons."
    },
    {
      "id": "pending",
      "title": "Training and submission readiness are separate",
      "text": "Five sentiment runs and 2 of three caption runs are verified. Final submission files remain pending until all review gates are satisfied."
    },
    {
      "id": "test_scope",
      "title": "Tests check implementation",
      "text": "The 23 tests include synthetic fixtures and real encoder passes on synthetic images. They do not measure real-data accuracy, replace full COCO training or establish that every possible defect is absent."
    }
